  "license": "MIT",
  "dependencies": {
    "phaser": "^4.2.1",
    "posthog-js": "^1.414.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
